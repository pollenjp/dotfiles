{
  "global": {
    "ctrl-k": "mod.open:pjp-prefix",
    "ctrl-q": "mod.open:pjp-worktree-remove",
    "ctrl-up": "tab.prev",
    "ctrl-down": "tab.next",
    "ctrl-alt-up": "space.prev",
    "ctrl-alt-down": "space.next",
    "ctrl-pageup": "space.prev",
    "ctrl-pagedown": "space.next"
  },
  "mod:pjp-prefix": {
    "ctrl-k": "pjp-prefix.literal"
  },
  "mod:pjp-worktree-remove": {
    "ctrl-q": "pjp-worktree-remove.again"
  }
}
