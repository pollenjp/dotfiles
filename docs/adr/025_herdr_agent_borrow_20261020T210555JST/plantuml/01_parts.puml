@startuml
!theme plain
title 固定名の先を動かすのは attach (包んだ herdr) と見張り (path unit) の 2 つだけ。rc は記録するだけ

' PlantUML の creole では ~ がエスケープになるので、パスは $HOME で書く
left to right direction
skinparam componentStyle rectangle
skinparam defaultTextAlignment center

node "手元の PC (Windows)" as PC {
  component "herdr.exe --remote" as HE
  component "ssh.exe\nSetEnv PJP_SSH_CLIENT=%u@%L" as SSHEXE
}

node "ssh 先 (lavie)" as LAVIE {
  component "sshd\nAcceptEnv PJP_SSH_CLIENT" as SSHD
  file "$HOME/.ssh/agent/s.*.sshd.*\n(接続ごとの socket)" as SOCK
  component "$HOME/.ssh/rc\n→ pjp-agent-link rc" as RC
  database "$HOME/.local/state/pjp-agent-link\nconn/ (接続の記録: 値・開いた時刻)\nowner/ (固定名ごとの持ち主)" as STATE
  component "bin/herdr (包んだ herdr)\n→ pjp-agent-link open attach" as WRAP
  file "$HOME/.ssh/agent.sock\n$HOME/.ssh/agent.<session>.sock\n(session ごとの固定名)" as FIXED
  component "herdr server と pane\nSSH_AUTH_SOCK = 固定名" as SERVER
  component "pjp-agent-link-watch.path\n→ pjp-agent-link watch" as WATCH
}

HE --> SSHEXE : 確認用の短い接続と\nbridge の接続
SSHEXE --> SSHD : ForwardAgent yes\nPJP_SSH_CLIENT=polle@PJP-RAIDEN
SSHD --> SOCK : forward した socket を作る\n(閉じると消す)
SSHD --> RC : 接続のたびに走らせる
RC --> STATE : socket・値・時刻を記録\n(張り替えない)
SSHD --> WRAP : exec … remote-client-bridge
WRAP --> FIXED : 先が死んでいる・持ち主が違うときだけ\n開いた接続へ向ける
WRAP --> SERVER : SSH_AUTH_SOCK を固定名にして\n本物の herdr を exec
SERVER --> FIXED : 鍵を使うときに辿る
WATCH ..> SOCK : 増えた・減った
WATCH ..> STATE : 記録が増えた
WATCH --> FIXED : 先が死んだら、持ち主と同じ値の\n生きている一番古い接続を借りる
@enduml
