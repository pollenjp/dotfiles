@startuml
' 変更後の構成: ADR 010 の経路 (win/ を WSL の bootstrap が /mnt/c へコピーして配る) に、
' Google 日本語入力を組み立てて配る手順と、PowerToys に読み直させる手順を足した。
' 矢印は中身の流れの向き (元 → 手順 → Windows 側) に揃え、左から右へ流れるように描く。
' 別名 (local, hosts, hm, st, state, rec, win, lib, boot, wroot, dst, orca) は ADR 010 の
' 01_flow.puml と揃えてある。新しい手順が持つ記録 (deployed.json・backup/・.reloaded) は
' 03 と 06 の図に描く。
' NOTE: PlantUML では "~" がエスケープ文字として消費されるため "$HOME/" 表記を使う
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Noto Sans CJK JP"
skinparam shadowing false
skinparam nodesep 18
skinparam ranksep 55
skinparam rectangle {
  BorderColor #666666
  BackgroundColor #F7F7F7
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #AAAAAA
}

title Windows 側の設定を配る経路（Google 日本語入力と PowerToys を足した後）

rectangle "$HOME/dotfiles\n（ローカル flake）" as local
rectangle "nix/hosts/default.nix\nwsl.windowsFiles.enable" as hosts
rectangle "home-manager switch\n**pjp-google-ime を**\n**PATH に入れる**" as hm

rectangle "win/（repo 直下）\nmanifest.toml\n（**PowerToys の 2 件を足す**）\n**powertoys/keyboard-manager/**\norca/ powershell/ herdr/ …" as win
rectangle "**win/google-japanese-input/**\nconfig.txtpb\nkeymap.tsv・romaji.tsv" as imetxt #D5E8D4
rectangle "**bootstrap-dotfiles-private.sh**\norder 50" as fetch #D5E8D4
rectangle "**pollenjp/dotfiles-private**\n（private・ghq の下）\ndictionaries/<名前>.tsv" as priv #D5E8D4

rectangle "nix/lib/windows-files.nix\nmanifest → 配置計画" as lib
rectangle "**pjp-google-ime**\nbuild・decode\nimport・digest" as tool #D5E8D4

rectangle "$HOME/.local/state/dotfiles/" as st #FFFFFF {
  rectangle "windows-files.json" as state
  rectangle "windows-files.deployed.json" as rec
}

rectangle "bootstrap-windows-files.sh\norder 90" as boot
rectangle "**bootstrap-windows-powertoys.sh**\norder 91" as ptboot #D5E8D4
rectangle "**bootstrap-windows-google-ime.sh**\norder 98" as imeboot #D5E8D4

rectangle "Windows（/mnt/c/Users/polle）" as wroot #FFFFFF {
  rectangle ".orca/keybindings.json など" as dst #FFF2CC
  rectangle "**PowerToys/Keyboard Manager/**\ndefault.json・editorSettings.json" as ptdst #FFF2CC
  rectangle "**Keyboard Manager のエンジン**" as kbm #FFF2CC
  rectangle "**Google Japanese Input/**\nconfig1.db・user_dictionary.db" as imedst #FFF2CC
  rectangle "**GoogleIMEJaConverter.exe**\n（変換サーバー）" as conv #FFF2CC
  rectangle "Orca" as orca
}

local --> hosts
hosts --> hm
hm --> state : 置く
hm --> tool : PATH

win --> lib
lib --> boot : 配置計画
state --> boot
boot --> rec
boot --> dst : コピー
boot --> ptdst : コピー
dst --> orca : hint

ptboot --> kbm : イベント
ptdst --> kbm : 読み直す

fetch --> priv : clone / pull
imetxt --> tool
priv --> tool
tool --> imeboot : 組み立てたもの
imeboot --> imedst : 退避して置く
imeboot --> conv : taskkill /F
imedst --> conv : 起動時に読む

legend right
  |<#D5E8D4> 今回追加（太字の要素） |
  |<#FFF2CC> Windows 側のファイルとプロセス |
  |<#F7F7F7> 既存（ADR 010 ほか） |
endlegend
@enduml
