@startuml
' 画面で変えた分を repo のテキストへ取り込む流れ。
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Noto Sans CJK JP"
skinparam shadowing false
skinparam sequence {
  ParticipantBorderColor #666666
  ParticipantBackgroundColor #F7F7F7
  LifeLineBorderColor #AAAAAA
}
skinparam note {
  BorderColor #AAAAAA
}

title 画面で変えた分を取り込む（--import）

actor "ユーザー" as U
participant "設定画面" as G
participant "Windows 側\nconfig1.db\nuser_dictionary.db" as F
participant "bootstrap-windows-\ngoogle-ime.sh" as B
participant "repo のテキスト\nwin/google-japanese-input/\ndotfiles-private" as T

U -> G : キー設定を変えて OK
G -> F : 書く（サーバー経由）
U -> B : setup --update
B -> F : digest を比べる
note over B #FFE6CC : 衝突\ndecode したテキストの diff を出して止まる
U -> B : --import
B -> F : decode する
B -> T : テキストを書き直す
note over B #D5E8D4 : 組み立て直して Windows 側と\n同じ中身になることを確かめてから\n記録を合わせる
U -> T : git diff を見て commit\n（dotfiles と dotfiles-private）
U -> B : setup --update
B -> F : digest を比べる
note over B #D5E8D4 : 同じなので何もしない
@enduml
