@startuml
' 変更後の構成: ADR 015 の経路に、2 つのアプリの本体を winget で入れる手順を足した。
' スクリプトは herdr・OpenSSH と同じく win/ に置き、bootstrap-windows-files.sh (90) が配り、
' bootstrap が pwsh.exe で呼ぶ。足すもの・変えるものを太字と緑で描く。
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Noto Sans CJK JP"
skinparam shadowing false
skinparam nodesep 18
skinparam ranksep 55
skinparam rectangle {
  BorderColor #666666
  BackgroundColor #F7F7F7
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #AAAAAA
}

title Windows のアプリ本体を入れる経路（TKT-143 で足した後）

rectangle "win/（repo 直下）" as win {
  rectangle "**google-japanese-input/**\n**Install-GoogleJapaneseInput.ps1**\n（-Version 3.34.6260.0）" as gps #D5E8D4
  rectangle "**powertoys/**\n**Install-PowerToys.ps1**\n（版は固定しない）" as pps #D5E8D4
  rectangle "manifest.toml\n（**2 件を足す**）" as man
}

rectangle "bootstrap-windows-files.sh\norder 90" as files

rectangle "Windows" as w {
  rectangle "%USERPROFILE%\\.config\\powershell\\\nInstall-*.ps1\n（PowerShell の関数からも打てる）" as dst
  rectangle "winget" as wg
  rectangle "Google 日本語入力\n（machine の MSI・UAC）" as gime
  rectangle "PowerToys\n（user スコープ）" as pt
}

rectangle "**bootstrap-windows-powertoys.sh**\norder 91\n**無ければ入れてから**読み直させる" as b91 #D5E8D4
rectangle "**bootstrap-windows-google-ime-install.sh**\norder 95（新）\n固定した版と比べ、無ければ入れる" as b95 #D5E8D4
rectangle "bootstrap-windows-google-ime.sh\norder 98\n設定と辞書を組み立てて置く\n（**まだ使っていないときの案内**）" as b98

man --> files
gps --> files
pps --> files
files --> dst : 置く
b91 --> dst : pwsh.exe\n-Check / -IfMissing
b95 --> dst : pwsh.exe\n-Check / -IfMissing
dst --> wg
wg --> gime
wg --> pt
b98 ..> gime : 設定を置く

legend right
  |<#D5E8D4> 足す・変える |
  |<#F7F7F7> 今のまま |
  setup の順: 90 → 91 → 95 → 96 → 97 → 98
endlegend
@enduml
