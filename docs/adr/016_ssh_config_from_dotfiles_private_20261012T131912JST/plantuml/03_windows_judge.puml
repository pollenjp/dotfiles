@startuml
' bootstrap-windows-ssh-config.sh が Windows のファイル 1 つごとに行う判定
skinparam defaultFontName "Noto Sans CJK JP"
skinparam shadowing false
skinparam activity {
  BackgroundColor #D5E8D4
  BorderColor #666666
  DiamondBackgroundColor #F7F7F7
  DiamondBorderColor #666666
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #AAAAAA
}

title Windows のファイル 1 つごとの判定（bootstrap-windows-ssh-config.sh）

start
if (正本にある?) then (ある: config と ssh/*.ssh_config)
  if (置き先はある?) then (無い)
    :コピーする（tmp + mv）
    記録する;
  elseif (置き先の中身は正本と同じ?) then (同じ)
    :何もしない
    （記録が無ければ記録だけ）; <<#F7F7F7>>
  elseif (置き先の中身は記録と一致?) then (一致 = 正本が更新された)
    :上書きする（tmp + mv）
    記録を更新する;
  elseif (config が旧経路の Include の 1 行だけ?) then (そう)
    :置き換える（tmp + mv）
    記録する;
  elseif (--force?) then (あり)
    :元を .dotfiles-bak-日時 に退避して
    上書きする・記録する;
  else (無し = Windows で変わった・名前がぶつかる)
    :衝突
    diff を出して触らない; <<#FFE6CC>>
  endif
else (無い: 記録にあって正本から消えた)
  if (置き先はある?) then (無い)
    :記録から外す; <<#F7F7F7>>
  elseif (置き先の中身は記録と一致?) then (一致)
    :消す
    記録から外す;
  elseif (--force?) then (あり)
    :元を .dotfiles-bak-日時 に退避して
    消す・記録から外す;
  else (無し = Windows で変わった)
    :衝突
    消さない; <<#FFE6CC>>
  endif
endif
stop

legend right
  |<#D5E8D4> 置き先を書く・消す |
  |<#F7F7F7> 置き先に触らない |
  |<#FFE6CC> 衝突（触らない。全部を処理してから exit 1） |
  正本の ssh/ が無い・空なら、どのファイルにも触らず警告して exit 0
  --dry-run は判定だけ出し、どの分岐でも書かない
endlegend
@enduml
