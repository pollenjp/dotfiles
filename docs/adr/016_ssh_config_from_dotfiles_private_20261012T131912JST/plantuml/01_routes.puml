@startuml
' ssh の接続先を配る経路: ADR 016 の後の姿
' 緑 = 今回足したもの。赤 = 今回外したもの・使わなくなる経路。灰 = 変わらないもの。
' NOTE: PlantUML では "~" がエスケープ文字として消費されるため "$HOME/" 表記を使う
skinparam defaultFontName "Noto Sans CJK JP"
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 70
skinparam rectangle {
  BorderColor #666666
  BackgroundColor #F7F7F7
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #AAAAAA
}
left to right direction

title ssh の接続先を配る経路（緑は ADR 016 で足したもの、赤は外すもの）

rectangle "pollenjp/dotfiles-private（private）" as priv #FFFFFF {
  rectangle "**ssh/*.ssh_config**\n接続先の正本（新規）" as privssh #D5E8D4
}

rectangle "pollenjp/dotfiles" as repo #FFFFFF {
  rectangle "**.ssh**（submodule: dotfiles-ssh）\n外す" as sshsub #F8CECC
}

rectangle "WSL / Linux / macOS" as unix #FFFFFF {
  rectangle "**dotfiles-private の clone**\n$HOME/ghq/github.com/pollenjp/dotfiles-private" as clone
  rectangle "**$HOME/.ssh/config.d/**\nsymlink" as confd
}

rectangle "Windows: %USERPROFILE%\\.ssh" as win #FFFFFF {
  rectangle "**config**\nInclude config.d/*.ssh_config" as wconf #D5E8D4
  rectangle "**config.d\\**\ndotfiles のコピー + my-cloud などのファイル" as wconfd #D5E8D4
}

rectangle "**旧 clone C:\\Users\\polle\\dotfiles**\nssh_config と .ssh（ssh からは読まれなくなる）" as oldclone #F8CECC
rectangle "my-cloud の ssh-config.sh" as mycloud

privssh --> clone : bootstrap-dotfiles-private.sh（50）\nclone / pull
clone -[#2E7D32]-> confd : <color:#2E7D32>bootstrap-ssh-config.sh（60・新規）</color>\n<color:#2E7D32>symlink</color>
clone -[#2E7D32]-> wconf : <color:#2E7D32>bootstrap-windows-ssh-config.sh（91・新規）</color>\n<color:#2E7D32>config を置く</color>
clone -[#2E7D32]-> wconfd : <color:#2E7D32>91 がコピーし、置いた中身を記録する</color>
sshsub -[#B85450,dashed]-> confd : <color:#B85450>setup-ssh-config.sh（外す）</color>
wconf -[#B85450,dashed]-> oldclone : <color:#B85450>旧経路の Include（置き換える）</color>
mycloud --> wconfd : 書く（変わらない）

legend right
  |= 色 |= 意味 |
  |<#D5E8D4>| ADR 016 で足したもの |
  |<#F8CECC>| ADR 016 で外すもの・使わなくなる経路 |
  |<#F7F7F7>| 変わらないもの |
endlegend
@enduml
